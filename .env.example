APP_NAME="Radiator Outlet Budapest"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=hu
APP_FALLBACK_LOCALE=hu
APP_FAKER_LOCALE=hu_HU

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# SQLite (helyi gyors start)
DB_CONNECTION=sqlite

# MySQL / MariaDB (XAMPP) – ha ezt használod, kommenteld ki a sqlite sort
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3307
# DB_DATABASE=radiator_webshop
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="rendeles@radiatoroutlet.hu"
MAIL_FROM_NAME="Radiátor Outlet Budapest"

SHOP_OWNER_EMAIL="admin@radiatoroutlet.hu"
SHOP_PHONE="06204662774"
SHOP_PHONE_DISPLAY="06 20 466 2774"
SHOP_SHIPPING_FEE=2500
SHOP_PICKUP_ADDRESS="Budapest XXIII. kerület, Soroksár"
ADMIN_EMAIL="admin@radiatoroutlet.hu"
ADMIN_PASSWORD="Admin123!"

VITE_APP_NAME="${APP_NAME}"
